# ─────────────────────────────────────────────────────────────────────────────
# GEEX — variables de entorno
#
# Este archivo solo contiene los NOMBRES de las variables, nunca valores.
# No lo rellenes a mano: ejecuta el script de configuración, que crea un
# archivo `.env` (ignorado por git) con secretos aleatorios generados en tu equipo:
#
#   Windows:     powershell -ExecutionPolicy Bypass -File scripts/setup.ps1
#   Linux/macOS: ./scripts/setup.sh
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos (PostgreSQL)
GEEX_DB_NAME=
GEEX_DB_ADMIN_USER=
GEEX_DB_ADMIN_PASSWORD=
GEEX_DB_APP_PASSWORD=

# Seguridad: clave HS256 para firmar los JWT (base64, mínimo 32 bytes)
GEEX_JWT_SECRET=

# URL pública del frontend (se usa en los enlaces de los correos)
GEEX_FRONTEND_URL=
