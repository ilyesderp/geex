  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowJs": false
  },
  "include": [
    "./**/*.ts",
    "../playwright.config.ts",
    "../playwright.visual.config.ts"
  ]
}
